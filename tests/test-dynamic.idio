;;
;; test-dynamic.idio
;;
dynamic0 := Tests

;; dynamic values

;; XXX be careful to use new non-lexical toplevel symbols...

;; have functions ready to test future dynamic variables
define (test-dvar-x1 exp) {
  ;; test a regular local
  test exp lex-x

  ;; test the dynamic variable
  test (dynamic dvar-x1) exp
}

;; a top-level lexical x
lex-x := 10

;; create a local dynamic variable
dynamic-let (dvar-x1 lex-x) {
  test (dynamic? 'dvar-x1) #t

  ;; test it here
  test (dynamic dvar-x1) lex-x

  ;; test it in our prepared function
  test-dvar-x1 lex-x
}

;; create a toplevel dynamic variable
dvar-x2 :~ 11
test (dynamic? 'dvar-x2) #t

define (test-dvar-x2 exp) {
  ;; test the dynamic variable (in scope, this time)
  test dvar-x2 exp
}

;; test it here, inline
test dvar-x2 11

dvar-x2 = lex-x
;; test it in a prepared function
test-dvar-x2 lex-x

{
  ;; make sure the evaluator can discover our value by adding an
  ;; intermediate lexical
  local-x := lex-x * 2

  ;; nothing should have changed
  test-dvar-x2 lex-x

  ;; modify it -- this changes the top-level instance
  dvar-x2 = local-x
  test-dvar-x2 local-x

  ;; redefine it
  local-x2 := local-x + 10
  dvar-x2 :~ local-x2

  test-dvar-x2 local-x2

  {
    ;; Another redefinition
    local-x3 := local-x2 + 20
    dvar-x2 :~ local-x3

    test-dvar-x2 local-x3

    ;; set it again
    local-x4 := local-x2 * 2
    dvar-x2 = local-x4

    test-dvar-x2 local-x4
  }

  ;; After the above block, we should be back to local-x2
  test-dvar-x2 local-x2
}

;; After the above block, we should be back to local-x, ie. lex-x * 2,
;; because the top-level instance was modified in the block, before we
;; created new dynamic instances
test-dvar-x2 (lex-x * 2)

;; all done?
Tests? (dynamic0 + 14)
